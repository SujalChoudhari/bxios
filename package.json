{
  "name": "bxios-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"@bxios/*\" build",
    "test": "pnpm --filter \"@bxios/*\" test",
    "test:e2e": "pnpm build && vitest run e2e",
    "benchmark": "pnpm build && node benchmarks/bxios-vs-regular-api.mjs",
    "benchmark:multi": "pnpm build && node benchmarks/bxios-multi-client.mjs"
  },
  "devDependencies": {
    "@bxios/bxios": "workspace:*",
    "@bxios/server": "workspace:*",
    "@bxios/wire": "workspace:*",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "ws": "^8.16.0"
  }
}
